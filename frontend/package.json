{
  "name": "dayflow-frontend",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "type-check": "vue-tsc --noEmit && tsc -p e2e/tsconfig.json --noEmit",
    "test": "vitest run --exclude='e2e/**/*.spec.ts'",
    "test:e2e": "node e2e/run.mjs",
    "test:e2e:ui": "node e2e/run.mjs --ui"
  },
  "dependencies": {
    "element-plus": "2.14.6",
    "vue": "3.5.43"
  },
  "devDependencies": {
    "@playwright/test": "1.55.0",
    "@vitejs/plugin-vue": "6.0.9",
    "@vue/test-utils": "2.4.6",
    "jsdom": "26.1.0",
    "typescript": "5.9.3",
    "vite": "8.3.1",
    "vitest": "3.2.4",
    "vue-tsc": "3.0.6"
  }
}
